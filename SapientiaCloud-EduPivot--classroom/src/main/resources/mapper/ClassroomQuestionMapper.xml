<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dayz.sapientiacloud_edupivot.classroom.mapper.ClassroomQuestionMapper">

    <resultMap id="ClassroomQuestionMap" type="com.dayz.sapientiacloud_edupivot.classroom.entity.po.ClassroomQuestion">
        <id column="id" property="id"/>
        <result column="classroom_id" property="classroomId"/>
        <result column="question_id" property="questionId"/>
        <result column="publish_order" property="publishOrder"/>
        <result column="score" property="score"/>
        <result column="is_required" property="isRequired"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="deleted"/>
    </resultMap>

    <resultMap id="ClassroomQuestionVOMap" type="com.dayz.sapientiacloud_edupivot.classroom.entity.vo.ClassroomQuestionVO">
        <id column="id" property="id"/>
        <result column="classroom_id" property="classroomId"/>
        <result column="question_id" property="questionId"/>
        <result column="publish_order" property="publishOrder"/>
        <result column="score" property="score"/>
        <result column="is_required" property="isRequired"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="listByClassroomId" parameterType="java.util.UUID" resultMap="ClassroomQuestionMap">
        SELECT
            id,
            classroom_id,
            question_id,
            publish_order,
            score,
            is_required,
            start_time,
            end_time,
            create_time,
            update_time,
            is_deleted
        FROM mg_classroom_question
        WHERE classroom_id = #{classroomId}
          AND is_deleted = 0
        ORDER BY publish_order ASC, create_time ASC
    </select>


    <select id="listClassroomQuestion" resultMap="ClassroomQuestionMap">
        SELECT
            id,
            classroom_id,
            question_id,
            publish_order,
            score,
            is_required,
            start_time,
            end_time,
            create_time,
            update_time,
            is_deleted
        FROM mg_classroom_question
        WHERE is_deleted = 0
        <if test="classroomId != null">
            AND classroom_id = #{classroomId}
        </if>
        ORDER BY publish_order ASC, create_time ASC
    </select>

    <select id="listClassroomQuestionVO" resultMap="ClassroomQuestionVOMap">
        SELECT
            id,
            classroom_id,
            question_id,
            publish_order,
            score,
            is_required,
            start_time,
            end_time,
            create_time,
            update_time
        FROM mg_classroom_question
        WHERE is_deleted = 0
        <if test="classroomId != null">
            AND classroom_id = #{classroomId}
        </if>
        ORDER BY publish_order ASC, create_time ASC
    </select>

    <update id="softDeleteById" parameterType="java.util.UUID">
        UPDATE mg_classroom_question
        SET is_deleted = 1,
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="listVOByClassroomId" parameterType="java.util.UUID" resultMap="ClassroomQuestionVOMap">
        SELECT
            id,
            classroom_id,
            question_id,
            publish_order,
            score,
            is_required,
            start_time,
            end_time,
            create_time,
            update_time
        FROM mg_classroom_question
        WHERE classroom_id = #{classroomId}
          AND is_deleted = 0
        ORDER BY publish_order ASC, create_time ASC
    </select>

</mapper>