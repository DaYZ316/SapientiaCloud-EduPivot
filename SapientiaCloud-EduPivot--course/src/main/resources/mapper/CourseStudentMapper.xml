<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dayz.sapientiacloud_edupivot.course.mapper.CourseStudentMapper">

    <resultMap id="CourseStudentVOMap" type="com.dayz.sapientiacloud_edupivot.course.entity.vo.CourseStudentVO">
        <id column="student_id" property="studentId"/>
        <id column="course_id" property="courseId"/>
        <result column="grade" property="grade"/>
        <result column="enrollment_date" property="enrollmentDate"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="listCourseStudent" resultMap="CourseStudentVOMap"
            parameterType="com.dayz.sapientiacloud_edupivot.course.entity.dto.CourseStudentQueryDTO">
        SELECT
        student_id,
        course_id,
        grade,
        enrollment_date,
        status,
        create_time,
        update_time
        FROM mg_course_student
        <where>
            <if test="studentId != null">
                AND student_id = #{studentId}
            </if>
            <if test="courseId != null">
                AND course_id = #{courseId}
            </if>
        </where>
        <if test="orderByColumn != null and orderByColumn != ''">
            ORDER BY ${orderByColumn} ${isAsc == 'asc' ? 'ASC' : 'DESC'}
        </if>
        <if test="orderByColumn == null or orderByColumn == ''">
            ORDER BY create_time DESC
        </if>
    </select>

    <select id="listAllCourseStudentByCourseId" resultMap="CourseStudentVOMap">
        SELECT
        student_id,
        course_id,
        grade,
        enrollment_date,
        status,
        create_time,
        update_time
        FROM mg_course_student
        <where>
            course_id = #{courseId}
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="listAllCourseStudentByStudentId" resultMap="CourseStudentVOMap">
        SELECT
        student_id,
        course_id,
        grade,
        enrollment_date,
        status,
        create_time,
        update_time
        FROM mg_course_student
        <where>
            student_id = #{studentId}
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="getStudentCourseById" resultMap="CourseStudentVOMap">
        SELECT
        student_id,
        course_id,
        grade,
        enrollment_date,
        status,
        create_time,
        update_time
        FROM mg_course_student
        <where>
            student_id = #{studentId} AND course_id = #{courseId}
        </where>
    </select>

    <insert id="addCourseStudent" parameterType="com.dayz.sapientiacloud_edupivot.course.entity.dto.CourseStudentDTO">
        INSERT INTO mg_course_student (student_id,
                                       course_id,
                                       grade,
                                       enrollment_date,
                                       status,
                                       create_time,
                                       update_time)
        VALUES (#{studentId},
                #{courseId},
                #{grade},
                #{enrollmentDate},
                #{status},
                NOW(),
                NOW())
    </insert>

    <update id="updateCourseStudent"
            parameterType="com.dayz.sapientiacloud_edupivot.course.entity.dto.CourseStudentDTO">
        UPDATE mg_course_student
        <set>
            <if test="grade != null">
                grade = #{grade},
            </if>
            <if test="enrollmentDate != null">
                enrollment_date = #{enrollmentDate},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            update_time = NOW()
        </set>
        <where>
            student_id = #{studentId} AND course_id = #{courseId}
        </where>
    </update>

    <delete id="removeCourseStudentById">
        DELETE FROM mg_course_student
        <where>
            student_id = #{studentId} AND course_id = #{courseId}
        </where>
    </delete>

    <delete id="removeCourseStudentByIds">
        DELETE FROM mg_course_student
        <where>
            course_id = #{courseId}
            AND student_id IN
            <foreach item="item" index="index" collection="studentIds" open="(" separator="," close=")">
                #{item}
            </foreach>
        </where>
    </delete>

</mapper>
